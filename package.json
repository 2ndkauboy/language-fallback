{
	"name": "language-fallback",
	"version": "2.1.1",
	"description": "Set a language as a fallback for the chosen language (e.g. \"Deutsch\" as a fallback for \"Deutsch (Sie)\")",
	"author": "Bernhard Kau",
	"license": "GPL-3.0-or-later",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/2ndkauboy/language-fallback.git"
	},
	"scripts": {
		"wp-env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"env:test:stop": "wp-env stop --config=.wp-env.test.json",
		"env:test:destroy": "wp-env destroy --config=.wp-env.test.json",
		"composer": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/language-fallback -- composer",
		"test:integration": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/language-fallback -- composer test:integration",
		"test:integration:multisite": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/language-fallback -- env WP_MULTISITE=1 composer test:integration",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug",
		"test:e2e:ui": "wp-scripts test-playwright --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@wordpress/e2e-test-utils-playwright": "^2.0.0",
		"@wordpress/env": "^11.15.0",
		"@wordpress/scripts": "^35.0.0"
	}
}
