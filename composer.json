{
    "name": "2ndkauboy/language-fallback",
    "description": "Set a language as a fallback for the chosen language (e.g. \"Deutsch\" as a fallback for \"Deutsch (Sie)\").",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Bernhard Kau"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "php": ">=5.6",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "yoast/wp-test-utils": "^1.2"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test:integration": "phpunit -c phpunit-integration.xml.dist --testsuite integration"
    }
}
